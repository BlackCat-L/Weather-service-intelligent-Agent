# ============ 大模型供应商配置 ============
# 切换供应商：改下面这行后重启服务，业务代码零改动。
# 新增供应商：在 backend/infra/config.py 的 PROVIDERS 里加一段即可（都走 OpenAI 兼容协议）。
LLM_PROVIDER=doubao

# --- 豆包（火山方舟）---
# 实测：Function Calling 可用，平均延迟约 0.9s/次
# 注意：新账户可能处于「安全体验模式」，有总量上限，用尽后返回
#      429 SetLimitExceeded，需到火山方舟控制台调整或开通付费
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-character-260628
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# --- 智谱（备选）---
# ⚠️ 必须用**标准端点**。coding 端点（/api/coding/paas/v4/）需要单独订阅
#    Coding Plan，普通 Key 会返回 429「余额不足或无可用资源包」。
# 实测：glm-4.5-flash / glm-4-flash 系列走免费额度，Function Calling 可用，
#       但延迟高（平均约 24.9s/次），不建议用于交互式演示。
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.5-flash
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# ============ 运行参数 ============
# 1 = 演示模式：不调真实模型，用于无 Key 联调
LLM_MOCK=0
LLM_TEMPERATURE=0.3
# 单次请求超时（秒）
LLM_TIMEOUT=120
# 工具调用最大轮次，防止模型陷入循环调用
MAX_TOOL_ROUNDS=6
